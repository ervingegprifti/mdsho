<Project>

  <!-- Applies to SDK-style .csproj only; the .wapproj (MSIX packaging) must not be affected. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Authors>Ervin Gegprifti</Authors>
    <Company>Ervin Gegprifti</Company>
    <Product>MDSHO</Product>
    <Copyright>Copyright (c) Ervin Gegprifti</Copyright>
    <!-- Semantic version (Major.Minor.Patch). AssemblyVersion/FileVersion become 1.5.8.0.
         Keep src\MDSHO.Package\Package.appxmanifest Identity Version in sync as Major.Minor.Patch.0 (the 4th part is reserved by the Store). -->
    <Version>1.5.8</Version>
    <!-- The MSIX package build (WAPP) builds the app and its project references with RuntimeIdentifier=win-x64,
         so restore must produce that target for every project. Restore-only: plain builds stay RID-neutral. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>