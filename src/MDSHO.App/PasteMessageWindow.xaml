<Window x:Class="MDSHO.PasteMessageWindow"
        xmlns:controls="clr-namespace:MDSHO.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MDSHO.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="460"
        SizeToContent="Height"
        MaxHeight="600"
        Icon="/Resources/logo.ico"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Template="{StaticResource RoundedWindowTemplate}"
        BorderBrush="{DynamicResource Theme.WindowBorder}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBackground}"
        UseLayoutRounding="True"
        Foreground="{DynamicResource Theme.Text}"
        helpers:WindowThemes.IsThemed="True">

    <!--Why a snippet could not paste: an info icon, a bold heading, the text and OK-->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

        <Grid x:Name="PanelMessage" Grid.Row="1" Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TextIcon" Grid.Column="0" FontFamily="{StaticResource IconFont}" FontSize="28" Margin="0,0,16,0"
                       VerticalAlignment="Top" Foreground="{DynamicResource Theme.TextStrong}" AutomationProperties.Name="Information"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TextHeading" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextStrong}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TextMessage" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Border x:Name="ButtonBar" Grid.Row="2" Background="{DynamicResource Theme.ButtonBarBackground}" Padding="26">
            <Button x:Name="ButtonOK" HorizontalAlignment="Right" Style="{StaticResource StyleDarkButton}" Content="OK" MinWidth="80" IsDefault="True" IsCancel="True"/>
        </Border>
    </Grid>

</Window>
