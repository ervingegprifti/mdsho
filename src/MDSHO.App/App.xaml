<Application x:Class="MDSHO.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MDSHO"
             xmlns:viewmodels="clr-namespace:MDSHO.ViewModels;assembly=MDSHO.ViewModels"
             xmlns:clr="clr-namespace:System;assembly=mscorlib">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The window theme's brushes: Light at start; Helpers/WindowThemes swaps it for Themes/Dark.xaml -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <!-- Thin scroll bars in every window -->
                <ResourceDictionary Source="Themes/ScrollBars.xaml"/>
                <!-- The rounded frame of MDSHO's own windows -->
                <ResourceDictionary Source="Themes/RoundedWindow.xaml"/>
                <ResourceDictionary>
                    <!-- View model Show... flags: true = Visible, false = Collapsed. -->
                    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
                    <FontFamily x:Key="IconFont">pack://application:,,,/Assets/Fonts/#MDSHOFont</FontFamily>
                    <!-- Syntax errors in tooltips, which keep the Windows look (themed windows use Theme.ErrorText) -->
                    <SolidColorBrush x:Key="ErrorBrush" Color="#FFC42B1C"/>

                    <Style x:Key="StyleMenuItemFontIcon" TargetType="{x:Type TextBlock}">
                        <Setter Property="Width" Value="16"/>
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.MenuIcon}"/>
                    </Style>

                    <Style x:Key="StyleDarkButton" TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="{DynamicResource Theme.Button}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.ButtonText}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <!--Dark buttons are 20,5 inside; one can set its own Padding (Settings: Apply is 22,5).-->
                        <Setter Property="Padding" Value="20,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0"
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.ButtonHover}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.ButtonText}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.ButtonPressed}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.ButtonText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="StyleLightButton" TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="{DynamicResource Theme.LightButton}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.LightButtonText}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        CornerRadius="5"
                                        Padding="20,8"
                                        BorderThickness="0"
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.LightButtonHover}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.LightButtonActiveText}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.LightButtonPressed}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.LightButtonActiveText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
