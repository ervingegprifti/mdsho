<Window x:Class="MDSHO.RunCommandExamplesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MDSHO.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:MDSHO.ViewModels;assembly=MDSHO.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:RunCommandViewModel}"
        Title="Examples"
        Width="460"
        Height="520"
        MinWidth="360"
        MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Template="{StaticResource RoundedWindowTemplate}"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        BorderBrush="{DynamicResource Theme.WindowBorder}"
        BorderThickness="1"
        UseLayoutRounding="True"
        Foreground="{DynamicResource Theme.Text}"
        helpers:WindowThemes.IsThemed="True"
        helpers:DialogKeys.FirstFocus="{Binding ElementName=ListExamples}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="StyleTitleBarButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextStrong}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <!--The glyph is drawn in a 16x16 box (StyleTitleBarFontIcon).-->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource StyleTitleBarFontIcon}" Text="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="0" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.BarButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.BarButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--An example group: a header with "+" (collapsed) or "−" (expanded) and the group's name, then its examples.
            The header is a toggle button, so a click, Enter or Space opens and closes the group.-->
        <Style x:Key="StyleExampleGroup" TargetType="{x:Type Expander}">
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <DockPanel>
                            <ToggleButton x:Name="GroupHeader" DockPanel.Dock="Top" Focusable="True" Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="HeaderBorder" Background="Transparent" Padding="2,6,2,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="GroupSign" Text="+" Width="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="GroupSign" Property="Text" Value="−"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Theme.BarButtonHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Theme.BarButtonHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="GroupItems" Visibility="Collapsed"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="GroupItems" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Title bar: title and close (no Cancel button: X and Esc close the popup)-->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Theme.BarBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextTitle" Grid.Column="0" Text="Examples" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Theme.TextStrong}"/>
                <Button x:Name="ButtonClose" Grid.Column="1" Style="{StaticResource StyleTitleBarButton}" Content="{Binding Icons.Times}" ToolTip="Close" AutomationProperties.Name="Close"/>
            </Grid>
        </Border>

        <!--Body: the grouped list fills it, with the look of the Note window's editor (window colour, no border, 10 px padding).
            What an example does and the command it runs show in its tooltip.-->
        <Grid x:Name="Body" Grid.Row="1" Background="{DynamicResource Theme.WindowBackground}">
            <Grid x:Name="BodyContent">
                <ListBox x:Name="ListExamples" DisplayMemberPath="Name" Padding="10" BorderThickness="0" Background="{DynamicResource Theme.WindowBackground}" IsSynchronizedWithCurrentItem="False">
                    <!--Each group starts collapsed every time the popup opens.-->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander Style="{StaticResource StyleExampleGroup}">
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="14,2,2,2"/>
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip>
                                        <StackPanel MaxWidth="320">
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding RunsText}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{DynamicResource Theme.ToolTipSecondaryText}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Grid>

        <!--Footer: Use only; every outer margin equals the button height (set in code from the real button)-->
        <Border x:Name="Footer" Grid.Row="2" Background="{DynamicResource Theme.BarBackground}">
            <Grid x:Name="FooterContent" Margin="26">
                <Button x:Name="ButtonUse" HorizontalAlignment="Right" Style="{StaticResource StyleDarkButton}" Content="Use" IsDefault="True" IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>

</Window>
