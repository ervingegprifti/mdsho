<Window x:Class="MDSHO.CommandErrorWindow"
        xmlns:controls="clr-namespace:MDSHO.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="460"
        SizeToContent="Height"
        MaxHeight="600"
        Icon="/Resources/logo.ico"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Template="{StaticResource RoundedWindowTemplate}"
        BorderBrush="#FFB9B39F"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F3ED"
        UseLayoutRounding="True">

    <!--The look of the error window, with only OK-->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

        <StackPanel x:Name="PanelMessage" Grid.Row="1" Margin="26">
            <TextBlock x:Name="TextError" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TextDetail" Margin="0,10,0,0" Foreground="#FF555555" TextWrapping="Wrap"/>
        </StackPanel>

        <Border x:Name="ButtonBar" Grid.Row="2" Background="#dddddd" Padding="26">
            <Button x:Name="ButtonOK" HorizontalAlignment="Right" Style="{StaticResource StyleDarkButton}" Content="OK" MinWidth="80" IsDefault="True" IsCancel="True"/>
        </Border>
    </Grid>

</Window>
