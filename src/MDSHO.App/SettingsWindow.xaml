<Window x:Class="MDSHO.SettingsWindow"
        xmlns:controls="clr-namespace:MDSHO.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MDSHO.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:viewmodels="clr-namespace:MDSHO.ViewModels;assembly=MDSHO.ViewModels"
        xmlns:converters="clr-namespace:MDSHO.Converters"
        d:DataContext="{d:DesignInstance Type=viewmodels:DesktopWindowViewModel}"
        Title="Settings"
        Width="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Template="{StaticResource RoundedWindowTemplate}"
        BorderBrush="{DynamicResource Theme.WindowBorder}"
        BorderThickness="1"
        Background="{DynamicResource Theme.WindowBackground}"
        ShowInTaskbar="True"
        WindowState="Normal"
        UseLayoutRounding="True"
        Foreground="{DynamicResource Theme.Text}"
        helpers:WindowThemes.IsThemed="True"
        helpers:DialogKeys.EscCloses="True"
        helpers:DialogKeys.FirstFocus="{Binding ElementName=ListSettingsPages}">

    <!--MDSHO's own title bar (DialogTitleBar) and the rounded frame (RoundedWindowTemplate), like the Colours window.
        The panel's colours are in the Colours window (the brush button next to the gear).-->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <converters:SolidIconsConverter x:Key="SolidIconsConverter"/>
            <!--A page or group title. The first one lines up with the top of the first page in the list.-->
            <Style x:Key="StyleSettingsCategory" TargetType="{x:Type Label}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.TextStrong}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <!--A short hint, 4 px under its own control.-->
            <Style x:Key="StyleSettingsHint" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <!--The buttons on the pages: filled like Apply, 26 px high.-->
            <Style x:Key="StyleSettingsButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StyleDarkButton}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!--A page on the right. Hidden pages keep their space, so the window fits the tallest page and never changes height.
                Tag is the page's item in the list.-->
            <Style x:Key="StyleSettingsPage" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Hidden"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!--An item of the page list: a 3 px accent bar on the left when selected.-->
            <Style x:Key="StyleSettingsPageItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="ItemBorder" Background="Transparent">
                                <Grid>
                                    <Border x:Name="SelectionBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Theme.Accent}" Visibility="Hidden"/>
                                    <ContentPresenter Margin="14,7"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.ItemHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.ItemSelected}"/>
                                    <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--The shortcut box looks like a text box. Its border darkens while recording.-->
            <Style x:Key="StyleShortcutBox" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource Theme.InputBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.InputText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.InputBorder}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BoxBorder" CornerRadius="3" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource Theme.InputBorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource Theme.InputBorderFocus}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!--Body-->
                <RowDefinition Height="*"/>
                <!--Footer-->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--The pages. To add one, add an item here and a panel in PanelBody whose Tag is that item.-->
                <Border x:Name="BorderSettingsPages" Grid.Column="0" Width="140" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Theme.BarBackground}">
                    <ListBox x:Name="ListSettingsPages" Background="Transparent" BorderThickness="0" Padding="0,26"
                             SelectionMode="Single"
                             KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource StyleSettingsPageItem}"
                             AutomationProperties.Name="Settings pages">
                        <ListBoxItem x:Name="PageItemAppearance" Content="Appearance"/>
                        <ListBoxItem x:Name="PageItemGeneral" Content="General"/>
                        <ListBoxItem x:Name="PageItemKeyboard" Content="Keyboard"/>
                        <ListBoxItem x:Name="PageItemScreens" Content="Screens"/>
                        <ListBoxItem x:Name="PageItemBackups" Content="Backups"/>
                        <ListBoxItem x:Name="PageItemSync" Content="Sync"/>
                    </ListBox>
                </Border>

                <!--Only the chosen page shows; all pages share this cell. Its margin is the Apply button height (set in code);
                    16 px between groups.-->
                <Grid x:Name="PanelBody" Grid.Column="1" Margin="26">
                    <StackPanel x:Name="PageAppearance" Style="{StaticResource StyleSettingsPage}" Tag="{Binding ElementName=PageItemAppearance}">
                        <Label Content="Icons appearance" Style="{StaticResource StyleSettingsCategory}"/>
                        <StackPanel x:Name="PanelIconsAppearance" Orientation="Vertical" helpers:DialogKeys.RadioGroup="True">
                            <RadioButton Content="Solid icons" Margin="0,0,0,5"
                                         IsChecked="{Binding Path=Appearance.SolidIcons, Mode=TwoWay, Converter={StaticResource SolidIconsConverter}, ConverterParameter=SolidIcons}" />
                            <RadioButton Content="Outlined icons"
                                         IsChecked="{Binding Path=Appearance.SolidIcons, Mode=TwoWay, Converter={StaticResource SolidIconsConverter}, ConverterParameter=OutlinedIcons}" />
                        </StackPanel>

                        <!--App-wide. Set in code; saved and applied on Apply.-->
                        <Label Content="Window theme" Margin="0,16,0,10" Style="{StaticResource StyleSettingsCategory}"/>
                        <StackPanel x:Name="PanelWindowTheme" Orientation="Vertical" helpers:DialogKeys.RadioGroup="True">
                            <RadioButton x:Name="RadioThemeSameAsWindows" Content="Same as Windows" Margin="0,0,0,5"/>
                            <RadioButton x:Name="RadioThemeLight" Content="Light" Margin="0,0,0,5"/>
                            <RadioButton x:Name="RadioThemeDark" Content="Dark"/>
                            <TextBlock x:Name="TextWindowThemeHint" Style="{StaticResource StyleSettingsHint}"
                                       Text="For MDSHO's own windows and menus, on this PC. Panels and notes keep their own colours."/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageGeneral" Style="{StaticResource StyleSettingsPage}" Tag="{Binding ElementName=PageItemGeneral}">
                        <Label Content="Other" Style="{StaticResource StyleSettingsCategory}"/>
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="CheckSingleClickToOpen" Content="Single click to open" IsChecked="{Binding Appearance.SingleClickToOpen}" />
                            <CheckBox x:Name="CheckShowVersionInTitle" Content="Show version in title" Margin="0,6,0,0"
                                      ToolTip="Shows the MDSHO version after this window's title, for example MDSHO v1.5.1"
                                      IsChecked="{Binding Appearance.ShowVersionInTitle}" />
                        </StackPanel>

                        <!--App-wide (exports carry it). Set in code; saved on Apply, which trims every history at once.-->
                        <Label Content="Text history" Margin="0,16,0,10" Style="{StaticResource StyleSettingsCategory}"/>
                        <StackPanel x:Name="PanelTextHistoryKeep" Orientation="Horizontal">
                            <ComboBox x:Name="ComboTextHistoryKeep" MinWidth="56" VerticalAlignment="Center"
                                      AutomationProperties.Name="Earlier texts to keep"/>
                            <TextBlock x:Name="TextTextHistoryKeep" Text="earlier texts to keep" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TextTextHistoryHint" Style="{StaticResource StyleSettingsHint}" Text="For notes, snippets and comments. 0 turns it off."/>
                    </StackPanel>
                    <StackPanel x:Name="PageKeyboard" Style="{StaticResource StyleSettingsPage}" Tag="{Binding ElementName=PageItemKeyboard}">
                        <!--App-wide. DataContext is a ShortcutRecorder, set in code.-->
                        <Label Content="Keyboard shortcut" Style="{StaticResource StyleSettingsCategory}"/>
                        <StackPanel x:Name="PanelShortcut" Orientation="Vertical" d:DataContext="{d:DesignInstance Type=viewmodels:ShortcutRecorder}">
                            <TextBlock x:Name="TextShortcutLabel" Text="Bring panels to front" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!--Click the box, then press the new shortcut.-->
                                <Button x:Name="ButtonShortcutBox" Grid.Column="0" Content="{Binding BoxText}"
                                        Style="{StaticResource StyleShortcutBox}"
                                        AutomationProperties.Name="Bring panels to front shortcut"
                                        ToolTip="Click, then press the new shortcut"/>
                                <Button x:Name="ButtonShortcutDefault" Grid.Column="1" Margin="6,0,0,0"
                                        Style="{StaticResource StyleSettingsButton}"
                                        ToolTip="Ctrl + Shift + Alt + M"
                                        Content="Default"/>
                                <Button x:Name="ButtonShortcutOff" Grid.Column="2" Margin="6,0,0,0"
                                        Style="{StaticResource StyleSettingsButton}"
                                        ToolTip="No shortcut"
                                        Content="Off"/>
                            </Grid>
                            <TextBlock x:Name="TextShortcutHint" Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HintIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.HintErrorText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageScreens" Style="{StaticResource StyleSettingsPage}" Tag="{Binding ElementName=PageItemScreens}">
                        <!--App-wide. Set in code; saved on Apply.-->
                        <Label Content="Screen setups" Style="{StaticResource StyleSettingsCategory}"/>
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="CheckRememberScreenSetups" Content="Remember places for each screen setup"/>
                            <TextBlock x:Name="TextScreenSetupsHint" Style="{StaticResource StyleSettingsHint}"
                                       Text="For all panels and notes, on this PC. When screens are connected or disconnected, they move to where they were last time with those screens."/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageBackups" Style="{StaticResource StyleSettingsPage}" Tag="{Binding ElementName=PageItemBackups}">
                        <!--App-wide, on this PC. Set in code; on/off, folder and keep count saved on Apply. Back up now acts at once.-->
                        <Label Content="Backups" Style="{StaticResource StyleSettingsCategory}"/>
                        <CheckBox x:Name="CheckBackupOn" Content="Back up my data every day"/>
                        <TextBlock x:Name="TextBackupOnHint" Style="{StaticResource StyleSettingsHint}" Text="Only when something changed."/>

                        <TextBlock x:Name="TextBackupFolderLabel" Text="Folder" Margin="0,16,0,4" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextBackupFolder" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,0" Height="26"
                                     AutomationProperties.Name="Backup folder"/>
                            <Button x:Name="ButtonBackupFolderChange" Grid.Column="1" Margin="6,0,0,0" Width="32" Padding="0"
                                    Style="{StaticResource StyleSettingsButton}"
                                    ToolTip="Change folder" AutomationProperties.Name="Change folder"
                                    Content="..."/>
                            <Button x:Name="ButtonBackupFolderOpen" Grid.Column="2" Margin="6,0,0,0"
                                    Style="{StaticResource StyleSettingsButton}"
                                    ToolTip="Open the folder in Explorer"
                                    Content="Open"/>
                        </Grid>
                        <TextBlock x:Name="TextBackupFolderHint" Style="{StaticResource StyleSettingsHint}" Text="Pick a OneDrive or Google Drive folder to keep a copy in the cloud."/>

                        <StackPanel x:Name="PanelBackupKeep" Orientation="Horizontal" Margin="0,16,0,0">
                            <ComboBox x:Name="ComboBackupKeep" MinWidth="56" VerticalAlignment="Center"
                                      AutomationProperties.Name="Latest backups of this PC to keep"/>
                            <TextBlock x:Name="TextBackupKeep" Text="latest backups of this PC to keep" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!--Last backup, the red line after a failure, the hint, then Back up now. The space for two lines of the red
                            line is always kept (it ends in "..." and shows in full in its tooltip), so the window never grows.-->
                        <Grid x:Name="BackupStatusSpace" Margin="0,16,0,0" Height="116">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock x:Name="TextLastBackup"/>
                                <TextBlock x:Name="TextBackupError" Style="{StaticResource StyleSettingsHint}" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" MaxHeight="32"
                                           Foreground="{DynamicResource Theme.HintErrorText}"/>
                                <TextBlock x:Name="TextBackupRestoreHint" Style="{StaticResource StyleSettingsHint}" Text="Restore one with Import data."/>
                                <Button x:Name="ButtonBackUpNow" Margin="0,16,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource StyleSettingsButton}" Content="Back up now"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PageSync" Style="{StaticResource StyleSettingsPage}" Tag="{Binding ElementName=PageItemSync}">
                        <!--This PC's own settings. Set in code; on/off, folder and name saved on Apply. Sync now acts at once.-->
                        <Label Content="Sync" Style="{StaticResource StyleSettingsCategory}"/>
                        <CheckBox x:Name="CheckSyncOn" Content="Keep this PC in sync with my other PCs"/>
                        <TextBlock x:Name="TextSyncOnHint" Style="{StaticResource StyleSettingsHint}"
                                   Text="Panels, groups, buttons, notes, comments and snippets, with their text and colours. Window places and this PC's settings stay here."/>

                        <!--Sync through: Folder shows the folder row, Google Drive and OneDrive the account row (2.1.0).-->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                            <TextBlock x:Name="TextSyncKindLabel" Text="Sync through" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                            <ComboBox x:Name="ComboSyncKind" MinWidth="120" VerticalAlignment="Center" AutomationProperties.Name="Sync through">
                                <ComboBoxItem Content="Folder" Tag="Folder"/>
                                <ComboBoxItem Content="Google Drive" Tag="GoogleDrive"/>
                                <ComboBoxItem Content="OneDrive" Tag="OneDrive"/>
                            </ComboBox>
                        </StackPanel>
                        <Grid x:Name="GridSyncFolder">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextSyncFolder" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,0" Height="26"
                                     AutomationProperties.Name="Sync folder"/>
                            <Button x:Name="ButtonSyncFolderChange" Grid.Column="1" Margin="6,0,0,0" Width="32" Padding="0"
                                    Style="{StaticResource StyleSettingsButton}"
                                    ToolTip="Change folder" AutomationProperties.Name="Change sync folder"
                                    Content="..."/>
                            <Button x:Name="ButtonSyncFolderOpen" Grid.Column="2" Margin="6,0,0,0"
                                    Style="{StaticResource StyleSettingsButton}"
                                    ToolTip="Open the folder in Explorer" AutomationProperties.Name="Open sync folder"
                                    Content="Open"/>
                        </Grid>
                        <Grid x:Name="GridSyncAccount" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextSyncAccount" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,0" Height="26"
                                     AutomationProperties.Name="Sync account"/>
                            <Button x:Name="ButtonSyncConnect" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource StyleSettingsButton}"
                                    ToolTip="Sign in in your browser" Content="Connect..."/>
                            <Button x:Name="ButtonSyncDisconnect" Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource StyleSettingsButton}"
                                    ToolTip="Sign this PC out and forget the sign-in" Content="Disconnect"/>
                        </Grid>
                        <TextBlock x:Name="TextSyncFolderHint" Style="{StaticResource StyleSettingsHint}"
                                   Text="A folder all your PCs can reach: Google Drive or OneDrive for desktop, Dropbox, or a network drive. Pick the same one on each PC."/>
                        <TextBlock x:Name="TextSyncError" Style="{StaticResource StyleSettingsHint}" Visibility="Collapsed"
                                   Foreground="{DynamicResource Theme.HintErrorText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock x:Name="TextDeviceNameLabel" Text="This PC's name" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                            <TextBox x:Name="TextDeviceName" Width="230" VerticalContentAlignment="Center" Padding="4,0" Height="26"
                                     MaxLength="60" AutomationProperties.Name="This PC's name"/>
                        </StackPanel>
                        <TextBlock x:Name="TextDeviceNameHint" Style="{StaticResource StyleSettingsHint}" Text="Shown on your other PCs and in Text history."/>

                        <!--The status line with Sync now, its grey line, the backup notice once after joining, then the other PCs.-->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TextSyncStatus" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="ButtonSyncNow" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource StyleSettingsButton}" Content="Sync now"/>
                        </Grid>
                        <TextBlock x:Name="TextSyncStatusHint" Style="{StaticResource StyleSettingsHint}" Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                        <TextBlock x:Name="TextSyncBackupNotice" Style="{StaticResource StyleSettingsHint}" Visibility="Collapsed"/>

                        <TextBlock x:Name="TextSyncPeersLabel" Text="Other PCs in this sync" Margin="0,16,0,4" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <Border x:Name="BorderSyncPeers" BorderThickness="1" BorderBrush="{DynamicResource Theme.TextBoxBorder}" Height="80" ClipToBounds="True">
                            <StackPanel>
                                <Grid Background="{DynamicResource Theme.BarBackground}" Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PC" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Last sync" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="MDSHO" Margin="8,0" VerticalAlignment="Center" FontSize="12"/>
                                </Grid>
                                <ItemsControl x:Name="ListSyncPeers" AutomationProperties.Name="Other PCs in this sync">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewmodels:SyncPeerRow}">
                                            <Grid Height="26">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LastSync}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Version}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!--Like the other windows: every outer margin of the page and of the Apply bar equals the Apply button height (set in
                code from the real button).-->
            <Border x:Name="Footer" Grid.Row="1" Background="{DynamicResource Theme.BarBackground}">
                <Grid x:Name="FooterContent" Margin="26">
                    <Button x:Name="ButtonApply" HorizontalAlignment="Right" IsDefault="True"
                        Style="{StaticResource StyleDarkButton}"
                        Padding="22,5"
                        Content="Apply"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
