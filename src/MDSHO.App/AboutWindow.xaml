<Window x:Class="MDSHO.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MDSHO"
        mc:Ignorable="d"
        Title="About"
        Width="720"
        Height="600"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F3ED">

    <!--Resources-->
    <Window.Resources>
        <ResourceDictionary>
            <!--Label names sit in the Auto column of GridAboutLabels, so every value starts at the same x-->
            <Style x:Key="StyleLabel" TargetType="{x:Type Label}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="Padding" Value="0,0,0,0"/>
                <Setter Property="Grid.Column" Value="0"/>
            </Style>
            <Style x:Key="StyleValue" TargetType="{x:Type Label}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="Padding" Value="0,0,0,0"/>
            </Style>
            <Style x:Key="StyleLinkIcon" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{x:Static SystemColors.HotTrackBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--The third-party list takes the remaining height and scrolls inside it-->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--About MDSHO (white top area, ends with the fixed Third Party Notices heading)-->
        <StackPanel x:Name="PanelAbout" Grid.Row="0" Orientation="Vertical" Background="White">
            <Label Content="MDSHO (Multi Desktop Shortcut Organizer)"
                HorizontalAlignment="Left"
                Margin="26,26,26,10"
                Padding="0"
                FontWeight="Bold"
                FontSize="14" />

            <!--Label rows: names in an Auto column, values in one column next to it-->
            <Grid x:Name="GridAboutLabels" Margin="26,0,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--Pronounced-->
                <Label Grid.Row="0" Content="Pronounced: " Style="{StaticResource StyleLabel}"/>
                <TextBlock x:Name="TextPronounced" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"><Run FontStyle="Italic" Text="em-dee-show"/><Run Text=" (M, D, then &quot;show&quot;)"/></TextBlock>
                <!--Version-->
                <Label Grid.Row="1" Content="Version: " Style="{StaticResource StyleLabel}" />
                <Label x:Name="LabelVersion" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource StyleValue}" />
                <!--Developer-->
                <Label Grid.Row="2" Content="Developer: " Style="{StaticResource StyleLabel}"/>
                <Label Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" Content="Ervin Gegprifti" Style="{StaticResource StyleValue}"/>
                <!--E-mail-->
                <Label Grid.Row="3" Content="E-mail: " Style="{StaticResource StyleLabel}"/>
                <Label Grid.Row="3" Grid.Column="1" Margin="10,0,0,0" Content="gegprifti.ervin@gmail.com" Style="{StaticResource StyleValue}"/>
                <!--Project (source code and issues on GitHub); the link addresses are set from AppConstants in AboutWindow.xaml.cs-->
                <Label Grid.Row="4" Content="Source code: " Style="{StaticResource StyleLabel}"/>
                <Label Grid.Row="4" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource StyleValue}">
                    <Hyperlink x:Name="HyperlinkProject" TextDecorations="None">
                        github.com/ervingegprifti/mdsho
                    </Hyperlink>
                </Label>
                <!--Privacy Policy-->
                <Label Grid.Row="5" Content="Privacy policy: " Style="{StaticResource StyleLabel}"/>
                <Label Grid.Row="5" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource StyleValue}">
                    <Hyperlink x:Name="HyperlinkPrivacyPolicy" TextDecorations="None">
                        View Privacy Policy
                    </Hyperlink>
                </Label>
                <!--Terms & Conditions-->
                <Label Grid.Row="6" Content="Terms &amp; conditions: " Style="{StaticResource StyleLabel}"/>
                <Label Grid.Row="6" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource StyleValue}">
                    <Hyperlink x:Name="HyperlinkTermsAndConditions" TextDecorations="None">
                        View Terms &amp; Conditions
                    </Hyperlink>
                </Label>
                <!--Rate / Share (same actions as the window title menu items, see StoreActions); solid icons, the About window has no per-window icon setting-->
                <Label Grid.Row="7" Content="Microsoft Store: " Style="{StaticResource StyleLabel}"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal">
                    <TextBlock x:Name="TextBlockRateIcon" Text="{Binding Star, Source={x:Static local:AboutWindow.Icons}}" Style="{StaticResource StyleLinkIcon}"/>
                    <Label Style="{StaticResource StyleValue}" Margin="5,0,0,0">
                        <Hyperlink x:Name="HyperlinkRate" TextDecorations="None" ToolTip="Rate and review MDSHO in the Microsoft Store">Rate</Hyperlink>
                    </Label>
                    <TextBlock x:Name="TextBlockShareIcon" Text="{Binding Share, Source={x:Static local:AboutWindow.Icons}}" Style="{StaticResource StyleLinkIcon}" Margin="15,0,0,0"/>
                    <Label Style="{StaticResource StyleValue}" Margin="5,0,0,0">
                        <Hyperlink x:Name="HyperlinkShare" TextDecorations="None" ToolTip="Copy the MDSHO store link to share it with your friends">Share</Hyperlink>
                    </Label>
                </StackPanel>
            </Grid>

            <!--Copy Right, left-aligned at the label indent-->
            <TextBlock x:Name="TextCopyright" Text="{x:Static local:ThirdPartyNotices.Copyright}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left" HorizontalAlignment="Left" Margin="26,20,26,20" />

            <!--Third Party heading: stays put, only the list below scrolls-->
            <Label x:Name="LabelThirdPartyTitle" Content="Third-party notices" FontSize="14" FontWeight="Bold" Padding="0" HorizontalAlignment="Left" Margin="26,0,26,10" />
        </StackPanel>

        <!--Third Party list: one line per entry, never wraps; a longer future line gets a horizontal scroll bar.
            The window is 720 wide so the longest entry (Windows SDK for .NET) fits next to the vertical scroll bar.
            Outer margins are 26 px (AboutWindow.OuterMargin), the button height the other windows use; the bottom padding of 20
            plus the 6 px under each line puts the last line 26 px above the bottom.-->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0,10,0,20">
            <!--Entries come from ThirdPartyNotices.All (kept in sync with the shipped packages by ThirdPartyNoticesTests)-->
            <ItemsControl x:Name="ItemsThirdPartyNotices" ItemsSource="{x:Static local:ThirdPartyNotices.All}" Focusable="False" Margin="26,0,26,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ThirdPartyNotice}">
                        <!--Name (bold) version, License link (licence type), Project link; the inlines touch so no extra spaces appear-->
                        <TextBlock FontSize="12" TextWrapping="NoWrap" Margin="0,0,0,6"><Run
                            Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"/><Run
                            Text=" "/><Run
                            Text="{Binding Version, Mode=OneWay}"/><Run
                            Text=", "/><Hyperlink
                            NavigateUri="{Binding LicenseUrl}" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="None"><Run
                            Text="License"/></Hyperlink><Run
                            Text=" ("/><Run
                            Text="{Binding License, Mode=OneWay}"/><Run
                            Text="), "/><Hyperlink
                            NavigateUri="{Binding ProjectUrl}" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="None"><Run
                            Text="Project"/></Hyperlink></TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</Window>
