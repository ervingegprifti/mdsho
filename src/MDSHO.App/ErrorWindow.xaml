<Window x:Class="MDSHO.ErrorWindow"
        xmlns:controls="clr-namespace:MDSHO.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MDSHO error"
        Width="520"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="600"
        Icon="/Resources/logo.ico"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Template="{StaticResource RoundedWindowTemplate}"
        BorderBrush="#FFB9B39F"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F3ED"
        UseLayoutRounding="True">

    <!--MDSHO's own title bar (DialogTitleBar) and the rounded frame (RoundedWindowTemplate), like the Note window-->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--Short plain-English message, then the exception's own message. The full details are only copied, never shown.-->
            <!--26 px outer margins, the same as every other MDSHO window (AboutWindow.OuterMargin)-->
            <StackPanel x:Name="PanelMessage" Grid.Row="0" Margin="26">
                <TextBlock
                    x:Name="TextMessage"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#FF333333"
                    TextWrapping="Wrap"/>
                <ScrollViewer
                    MaxHeight="300"
                    Margin="0,10,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <TextBlock
                        x:Name="TextDetail"
                        Foreground="#FF555555"
                        TextWrapping="Wrap"/>
                </ScrollViewer>
                <TextBlock
                    Margin="0,14,0,0"
                    Foreground="DimGray"
                    TextWrapping="Wrap"
                    Text="The details were saved in the log file. Use Copy details to include them in a bug report."/>
            </StackPanel>

            <!--Buttons-->
            <Border x:Name="ButtonBar" Grid.Row="1" Background="#dddddd" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="ButtonCopyDetails"
                        Grid.Column="0"
                        Style="{StaticResource StyleLightButton}"
                        Content="Copy details"
                        Margin="0,0,8,0"/>
                    <Button
                        x:Name="ButtonOpenLogs"
                        Grid.Column="1"
                        Style="{StaticResource StyleLightButton}"
                        Content="Open logs folder"/>
                    <Button
                        x:Name="ButtonOK"
                        Grid.Column="3"
                        Style="{StaticResource StyleDarkButton}"
                        Content="OK"
                        MinWidth="80"
                        IsDefault="True"
                        IsCancel="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
