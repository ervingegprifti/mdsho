<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    The Light window theme: the colours MDSHO's own windows always had (Settings, Colours, Run command, Examples, About,
    the error windows and their title bar). Dark.xaml has the same keys. Windows use them through DynamicResource, and
    Helpers/WindowThemes swaps this dictionary for Dark.xaml at runtime. Panels and notes never use them: they have their
    own colours. Menus and the standard controls keep the Windows look here, so this dictionary has no styles.
    -->

    <!-- Window frame and bars -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FFF4F3ED"/>
    <SolidColorBrush x:Key="Theme.WindowBorder" Color="#FFB9B39F"/>
    <SolidColorBrush x:Key="Theme.BarBackground" Color="#FFDFDACB"/>
    <SolidColorBrush x:Key="Theme.ButtonBarBackground" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="Theme.CardBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.TitleButtonHover" Color="#1F000000"/>
    <SolidColorBrush x:Key="Theme.TitleButtonPressed" Color="#33000000"/>
    <SolidColorBrush x:Key="Theme.BarButtonHover" Color="#FFCDC7B4"/>
    <SolidColorBrush x:Key="Theme.BarButtonPressed" Color="#FFBDB6A0"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Theme.Text" Color="#FF000000"/>
    <SolidColorBrush x:Key="Theme.TextStrong" Color="#FF333333"/>
    <SolidColorBrush x:Key="Theme.TextSecondary" Color="#FF5A5648"/>
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#FF555555"/>
    <SolidColorBrush x:Key="Theme.TextDim" Color="#FF696969"/>
    <SolidColorBrush x:Key="Theme.TextFaint" Color="#FF808080"/>
    <SolidColorBrush x:Key="Theme.ErrorText" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="Theme.HintErrorText" Color="#FFFF0000"/>
    <SolidColorBrush x:Key="Theme.Link" Color="{x:Static SystemColors.HotTrackColor}"/>
    <!-- Tooltips keep the Windows look in both themes -->
    <SolidColorBrush x:Key="Theme.ToolTipSecondaryText" Color="#FF666666"/>

    <!-- Inputs and lists -->
    <SolidColorBrush x:Key="Theme.InputBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.InputText" Color="#FF000000"/>
    <SolidColorBrush x:Key="Theme.InputBorder" Color="#FFB9B39F"/>
    <SolidColorBrush x:Key="Theme.InputBorderHover" Color="#FF808080"/>
    <SolidColorBrush x:Key="Theme.InputBorderFocus" Color="#FF424242"/>
    <SolidColorBrush x:Key="Theme.ReadOnlyBackground" Color="#FFEAE7DC"/>
    <SolidColorBrush x:Key="Theme.ItemHover" Color="#FFEAE7DC"/>
    <SolidColorBrush x:Key="Theme.ItemSelected" Color="#FFDCEBFA"/>
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF1F6FC5"/>
    <SolidColorBrush x:Key="Theme.SwatchBorder" Color="#FF8C8778"/>
    <SolidColorBrush x:Key="Theme.PaletteBorder" Color="#FFC9C3B1"/>

    <!-- MDSHO's buttons (StyleDarkButton, StyleLightButton) -->
    <SolidColorBrush x:Key="Theme.Button" Color="#FF808080"/>
    <SolidColorBrush x:Key="Theme.ButtonHover" Color="#FF696969"/>
    <SolidColorBrush x:Key="Theme.ButtonPressed" Color="#FF555555"/>
    <SolidColorBrush x:Key="Theme.ButtonText" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.SecondaryButton" Color="#FFA09A88"/>
    <SolidColorBrush x:Key="Theme.LightButton" Color="#FFD3D3D3"/>
    <SolidColorBrush x:Key="Theme.LightButtonText" Color="#FF000000"/>
    <SolidColorBrush x:Key="Theme.LightButtonHover" Color="#FF808080"/>
    <SolidColorBrush x:Key="Theme.LightButtonPressed" Color="#FF696969"/>
    <SolidColorBrush x:Key="Theme.LightButtonActiveText" Color="#FFFFFFFF"/>

    <!-- Menus: the icons and the Mark row of the right-click menus. In Light the menus keep the Windows look; the other menu keys are the Windows colours. -->
    <SolidColorBrush x:Key="Theme.MenuIcon" Color="#FF424242"/>
    <SolidColorBrush x:Key="Theme.MarkPanel" Color="#FFEEEEEE"/>
    <SolidColorBrush x:Key="Theme.MarkBorder" Color="#FFD3D3D3"/>
    <SolidColorBrush x:Key="Theme.MenuBackground" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="Theme.MenuBorder" Color="#FF999999"/>
    <SolidColorBrush x:Key="Theme.MenuText" Color="#FF000000"/>
    <SolidColorBrush x:Key="Theme.MenuHighlight" Color="#3D26A0DA"/>
    <SolidColorBrush x:Key="Theme.MenuHighlightBorder" Color="#FF26A0DA"/>
    <SolidColorBrush x:Key="Theme.MenuSeparator" Color="#FFD7D7D7"/>
    <SolidColorBrush x:Key="Theme.MenuDisabledText" Color="#FF707070"/>

    <!-- Standard controls: the Windows colours. Only the dark control styles (DarkControls.xaml) use these keys. -->
    <SolidColorBrush x:Key="Theme.TextBoxBorder" Color="#FFABADB3"/>
    <SolidColorBrush x:Key="Theme.FocusBorder" Color="#FF569DE5"/>
    <SolidColorBrush x:Key="Theme.Selection" Color="#FF0078D7"/>
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#FF707070"/>
    <SolidColorBrush x:Key="Theme.ControlBorderHover" Color="#FF5593FF"/>
    <SolidColorBrush x:Key="Theme.ControlPressed" Color="#FFD9ECFF"/>
    <SolidColorBrush x:Key="Theme.ControlGlyph" Color="#FF212121"/>
    <SolidColorBrush x:Key="Theme.ControlDisabledBackground" Color="#FFE6E6E6"/>
    <SolidColorBrush x:Key="Theme.ControlDisabledBorder" Color="#FFBCBCBC"/>
    <SolidColorBrush x:Key="Theme.ControlDisabledText" Color="#FF838383"/>
    <SolidColorBrush x:Key="Theme.StandardButton" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="Theme.StandardButtonBorder" Color="#FF707070"/>
    <SolidColorBrush x:Key="Theme.StandardButtonHover" Color="#FFBEE6FD"/>
    <SolidColorBrush x:Key="Theme.StandardButtonHoverBorder" Color="#FF3C7FB1"/>
    <SolidColorBrush x:Key="Theme.StandardButtonPressed" Color="#FFC4E5F6"/>
    <SolidColorBrush x:Key="Theme.ListItemHover" Color="#1F26A0DA"/>
    <SolidColorBrush x:Key="Theme.ListItemSelected" Color="#3D26A0DA"/>

</ResourceDictionary>
