<Window x:Class="MDSHO.TextEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comment"
        Width="520"
        Height="400"
        MinWidth="380"
        MinHeight="300"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#FFF4F3ED"
        BorderBrush="#FFB9B39F"
        BorderThickness="1"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="StyleTitleBarButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="0" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--Shades instead of fixed colours, so the highlights work on any title bar colour of a note-->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StyleSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StyleDarkButton}">
            <Setter Property="Background" Value="#FFA09A88"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!--Title bar-->
            <RowDefinition Height="Auto"/>
            <!--Body-->
            <RowDefinition Height="*"/>
            <!--Footer-->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Title bar: icon, "Comment: <button name>" or "Note: <title>", then for a note only colours and pin (keep on top), then close.
            A note saves itself while you type, so it has no Save button. Pin uses the Windows icon font until MDSHOFont has its own glyph.-->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#FFDFDACB">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TextTitleIcon" FontFamily="{StaticResource IconFont}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="#FF333333"/>
                    <TextBlock x:Name="TextTitle" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="#FF333333" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="ButtonColors" Grid.Column="1" Style="{StaticResource StyleTitleBarButton}" FontSize="14"
                        ToolTip="Note colours" AutomationProperties.Name="Note colours" Visibility="Collapsed"/>
                <Button x:Name="ButtonPin" Grid.Column="2" Style="{StaticResource StyleTitleBarButton}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Content="&#xE718;" ToolTip="Keep on top" AutomationProperties.Name="Keep on top" Visibility="Collapsed"/>
                <Button x:Name="ButtonClose" Grid.Column="3" Style="{StaticResource StyleTitleBarButton}" ToolTip="Close" AutomationProperties.Name="Close"/>
            </Grid>
        </Border>

        <!--Body: the text (a comment has margins around a framed box; a note fills the body, see TextEditWindow.UseNoteLayout)-->
        <Grid x:Name="Body" Grid.Row="1" Background="#FFF4F3ED">
            <Grid x:Name="BodyContent" Margin="40,24,40,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="TextComment" Grid.Row="0"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="4,3"
                         AutomationProperties.Name="Comment"/>
                <TextBlock x:Name="TextHint" Grid.Row="1" Margin="0,8,0,0" Foreground="#FF666666"
                           Text="Ctrl+Enter saves. Esc closes without saving."/>
            </Grid>
        </Grid>

        <!--Footer: the note hint on the left (notes only), Save and Cancel on the right-->
        <Border x:Name="Footer" Grid.Row="2" Background="#FFDFDACB">
            <Grid x:Name="FooterContent" Margin="40,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextFooterHint" Grid.Column="0" VerticalAlignment="Center" Foreground="#FF555555" Visibility="Collapsed"
                           TextTrimming="CharacterEllipsis" Text="Ctrl+Enter saves. Esc closes without saving."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ButtonSave" Style="{StaticResource StyleDarkButton}" Content="Save" Margin="0,0,8,0"/>
                <Button x:Name="ButtonCancel" Style="{StaticResource StyleSecondaryButton}" Content="Cancel" IsCancel="True"/>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
