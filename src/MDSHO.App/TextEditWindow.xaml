<Window x:Class="MDSHO.TextEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comment"
        Width="420"
        Height="150"
        MinWidth="420"
        MinHeight="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Template="{StaticResource RoundedWindowTemplate}"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#FFF4F3ED"
        BorderBrush="#FFB9B39F"
        BorderThickness="1"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--Shades instead of fixed colours, so the highlights work on any title bar colour of a note. A comment removes
            these two, so it gets the window theme's shades (TextEditWindow.UseWindowTheme).-->
        <SolidColorBrush x:Key="Theme.TitleButtonHover" Color="#1F000000"/>
        <SolidColorBrush x:Key="Theme.TitleButtonPressed" Color="#33000000"/>
        <Style x:Key="StyleTitleBarButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <!--The glyph is drawn in a 16x16 box (StyleTitleBarFontIcon).-->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource StyleTitleBarFontIcon}" Text="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="0" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.TitleButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.TitleButtonPressed}" />
                            </Trigger>
                            <!--OK with no change to save is greyed out (faded, so it keeps the title text colour)-->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!--Title bar-->
            <RowDefinition Height="Auto"/>
            <!--Body-->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Title bar: icon and the button's name, then for a note text size, font, wrap text and pin (keep on top), for a
            snippet or a comment text size, font and wrap text, then More options and close. Every kind saves itself while you type and when it closes, so there is no OK.
            The pin is a thumbtack pointing left, or down while the note is on top. More options (and a right-click) opens the title menu, which has every
            command of the title bar and the ones used less often: Note colours, Text history and Clear all highlights.-->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#FFDFDACB">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!--The icon is centred on the title bar on its own, so the taller rename box doesn't move it.-->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextTitleIcon" Grid.Column="0" Style="{StaticResource StyleTitleBarFontIcon}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF333333"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TextTitle" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="#FF333333" TextTrimming="CharacterEllipsis"/>
                        <!--A note's title is renamed here: click the title text twice slowly; a double click maximises (Rename and F2 in the panel rename the button). Enter or leaving saves, Esc cancels.-->
                        <TextBox x:Name="TextTitleEdit" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" MinWidth="160" Padding="1,0"
                                 Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Note title"/>
                    </StackPanel>
                    <!--How many times the selected text appears ("3 matches"), only while it appears more than once.-->
                    <TextBlock x:Name="TextMatchCount" Grid.Column="2" Margin="8,0,6,0" VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                               Foreground="{Binding Foreground, ElementName=TextTitle}" Visibility="Collapsed"/>
                </Grid>
                <!--The text size button shows the size in points and opens the size menu. Wide enough for "72 pt", so the other buttons
                    don't move when the size changes.-->
                <Button x:Name="ButtonSize" Grid.Column="1" Style="{StaticResource StyleTitleBarButton}" FontFamily="Segoe UI" FontSize="12" Width="60" ContentTemplate="{x:Null}"
                        ToolTip="Text size" AutomationProperties.Name="Text size" Visibility="Collapsed"/>
                <!--The font button opens the font menu.-->
                <Button x:Name="ButtonFont" Grid.Column="2" Style="{StaticResource StyleTitleBarButton}"
                        ToolTip="Font" AutomationProperties.Name="Font" Visibility="Collapsed"/>
                <Button x:Name="ButtonWrap" Grid.Column="3" Style="{StaticResource StyleTitleBarButton}" ToolTip="Wrap text" AutomationProperties.Name="Wrap text"/>
                <Button x:Name="ButtonPin" Grid.Column="4" Style="{StaticResource StyleTitleBarButton}"
                        ToolTip="Keep on top" AutomationProperties.Name="Keep on top" Visibility="Collapsed"/>
                <!--More options opens the title menu (Alt+F too). Its icon and font come from IconGlyphs.More (see ShowIcons).-->
                <Button x:Name="ButtonMore" Grid.Column="5" Style="{StaticResource StyleTitleBarButton}"
                        ToolTip="More options" AutomationProperties.Name="More options"/>
                <Button x:Name="ButtonClose" Grid.Column="6" Style="{StaticResource StyleTitleBarButton}" ToolTip="Close" AutomationProperties.Name="Close"/>
            </Grid>
        </Border>

        <!--Body: the text fills it (window colour, no border, 20 px padding, no word wrap, each scroll bar only when needed).
            A click in the padding goes to the nearest spot of the text (see TextBoxPoints).
            Its size is set in code: 12 pt at first; the size button and Ctrl + mouse wheel change it.-->
        <Grid x:Name="Body" Grid.Row="1" Background="#FFF4F3ED">
            <TextBox x:Name="TextComment"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="NoWrap"
                     BorderThickness="0"
                     Padding="20"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Comment"/>
            <!--Highlights over the text (a text box can't colour parts of its text): drawn in code for the lines on screen,
                faint enough to read the text through, and never in the way of the mouse.-->
            <!--The current line: a faint shade on the caret's row, edge to edge, under the highlights (see TextHighlighter).-->
            <Canvas x:Name="LineLayer" IsHitTestVisible="False" ClipToBounds="True"/>
            <Canvas x:Name="HighlightLayer" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </Grid>
</Window>
