<Window x:Class="MDSHO.RunCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MDSHO.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:MDSHO.ViewModels;assembly=MDSHO.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:RunCommandViewModel}"
        Title="Run command"
        Width="560"
        Height="620"
        MinWidth="420"
        MinHeight="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Template="{StaticResource RoundedWindowTemplate}"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource Theme.WindowBackground}"
        BorderBrush="{DynamicResource Theme.WindowBorder}"
        BorderThickness="1"
        UseLayoutRounding="True"
        Foreground="{DynamicResource Theme.Text}"
        helpers:WindowThemes.IsThemed="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="StyleTitleBarButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextStrong}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="0" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.BarButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.BarButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StyleSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StyleDarkButton}">
            <Setter Property="Background" Value="{DynamicResource Theme.SecondaryButton}"/>
        </Style>
        <Style x:Key="StyleFieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,8,0,3"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextStrong}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!--Title bar-->
            <RowDefinition Height="Auto"/>
            <!--Body-->
            <RowDefinition Height="*"/>
            <!--Footer-->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Title bar: the command's name, examples (wizard), close. Double-clicking the title bar maximises and restores the window-->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Theme.BarBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!--The icon is centred on the title bar on its own, so the taller rename box doesn't move it.-->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextTitleIcon" Grid.Column="0" Text="{Binding Icons.Run}" FontFamily="{StaticResource IconFont}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Theme.TextStrong}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TextTitle" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Theme.TextStrong}"/>
                        <!--The command is renamed here: click the title text twice slowly; a double click maximises (Rename and F2 in the panel rename the button). Enter or leaving keeps
                            the new name, Esc the old one; Save writes it, Cancel throws it away.-->
                        <TextBox x:Name="TextTitleEdit" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" MinWidth="160" Padding="1,0"
                                 Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Command name"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="ButtonExamples" Grid.Column="1" Style="{StaticResource StyleTitleBarButton}" Content="{Binding Icons.Wizard}" ToolTip="Examples" AutomationProperties.Name="Examples"/>
                <Button x:Name="ButtonClose" Grid.Column="2" Style="{StaticResource StyleTitleBarButton}" Content="{Binding Icons.Times}" ToolTip="Close" AutomationProperties.Name="Close"/>
            </Grid>
        </Border>

        <!--Body-->
        <Grid x:Name="Body" Grid.Row="1" Background="{DynamicResource Theme.WindowBackground}">
            <Grid x:Name="BodyContent" Margin="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource StyleFieldLabel}" Text="Program"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ComboProgram" Grid.Column="0"
                              IsEditable="True"
                              ItemsSource="{Binding Programs}"
                              TextSearch.TextPath="FileName"
                              Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}"
                              Padding="4,3">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}"/>
                                    <TextBlock Text="{Binding FriendlyName}" Foreground="{DynamicResource Theme.TextFaint}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="ButtonBrowseProgram" Grid.Column="1" Margin="6,0,0,0" Padding="10,2" MinWidth="80" Content="Browse..."/>
                </Grid>

                <TextBlock Grid.Row="2" Style="{StaticResource StyleFieldLabel}" Text="Working folder (optional)"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextWorkingFolder" Grid.Column="0" Padding="2,3" VerticalContentAlignment="Center"
                             Text="{Binding WorkingFolder, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button x:Name="ButtonBrowseFolder" Grid.Column="1" Margin="6,0,0,0" Padding="10,2" MinWidth="80" Content="Browse..."/>
                </Grid>

                <TextBlock Grid.Row="4" Style="{StaticResource StyleFieldLabel}" Text="Arguments (one command per line)"/>
                <TextBox x:Name="TextArguments" Grid.Row="5"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         Padding="2"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <!--Its own style replaces the dark text box style, so it sets the theme colours itself (the Windows ones in Light)-->
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="{DynamicResource Theme.InputBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.InputText}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.TextBoxBorder}"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource Theme.InputText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.ErrorText}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <!--Keeps the red border while the box has focus, where the theme draws its own focus border-->
                <Border Grid.Row="5" BorderThickness="1" BorderBrush="{DynamicResource Theme.ErrorText}" IsHitTestVisible="False"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <!--The group-value syntax error, in red under the arguments-->
                <TextBlock x:Name="TextArgumentsError" Grid.Row="6" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.ErrorText}"
                           Text="{Binding Error, Mode=OneWay}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <!--The group's values: a click inserts one at the caret in the arguments. Without values, a hint (red when one is used)-->
                <StackPanel Grid.Row="7" Margin="0,6,0,0">
                    <TextBlock x:Name="TextGroupValuesLabel" Foreground="{DynamicResource Theme.TextMuted}" Text="{x:Static viewmodels:RunCommandViewModel.GroupValuesLabel}"
                               Visibility="{Binding HasGroupValues, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl x:Name="ListGroupValues" ItemsSource="{Binding GroupValues}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Margin="0,3,6,0" Padding="6,1" FontFamily="Consolas" Focusable="False"
                                        Cursor="Hand" ToolTip="{Binding Token}" Click="GroupValueButton_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TextNoGroupValues" TextWrapping="Wrap" Text="{x:Static viewmodels:RunCommandViewModel.NoGroupValuesText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGroupValues}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNoGroupValuesError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.ErrorText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <CheckBox x:Name="CheckKeepOpen" Grid.Row="8" Margin="0,10,0,0"
                          Content="Keep window open after it runs"
                          IsChecked="{Binding KeepWindowOpen}"
                          IsEnabled="{Binding IsKeepOpenEnabled}"/>
                <CheckBox x:Name="CheckRunAsAdmin" Grid.Row="9" Margin="0,6,0,0"
                          Content="Run as administrator"
                          IsChecked="{Binding RunAsAdministrator}"/>

                <TextBlock Grid.Row="10" Style="{StaticResource StyleFieldLabel}" Margin="0,12,0,3" Text="Will run as"/>
                <TextBox x:Name="TextPreview" Grid.Row="11"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinLines="1"
                         MaxLines="4"
                         FontFamily="Consolas"
                         FontSize="13"
                         Padding="2"
                         Background="{DynamicResource Theme.ReadOnlyBackground}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Text="{Binding Preview, Mode=OneWay}"/>
            </Grid>
        </Grid>

        <!--Footer: Test run on the left, Save and Cancel on the right-->
        <!--Every outer margin of the fields and of the bottom bar equals the button height (set in code from the real button)-->
        <Border x:Name="Footer" Grid.Row="2" Background="{DynamicResource Theme.BarBackground}">
            <Grid x:Name="FooterContent" Margin="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ButtonTestRun" Grid.Column="0" Style="{StaticResource StyleSecondaryButton}" Content="&#x25B6; Test run" ToolTip="Runs what is on screen now, without saving"/>
                <!--"Fix the error to save." or "Fix the error to run." after a refused Save or Test run-->
                <TextBlock x:Name="TextFooterError" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.ErrorText}"
                           Text="{Binding FooterError}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FooterError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="ButtonSave" Grid.Column="2" Style="{StaticResource StyleDarkButton}" Content="Save" IsDefault="True" Margin="0,0,8,0"/>
                <Button x:Name="ButtonCancel" Grid.Column="3" Style="{StaticResource StyleSecondaryButton}" Content="Cancel" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>

</Window>
