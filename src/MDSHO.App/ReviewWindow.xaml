<Window x:Class="MDSHO.ReviewWindow"
        xmlns:controls="clr-namespace:MDSHO.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MDSHO.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MDSHO"
        Width="340"
        SizeToContent="Height"
        Icon="/Resources/logo.ico"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Template="{StaticResource RoundedWindowTemplate}"
        BorderBrush="{DynamicResource Theme.WindowBorder}"
        BorderThickness="1"
        Background="{DynamicResource Theme.WindowBackground}"
        UseLayoutRounding="True"
        Foreground="{DynamicResource Theme.Text}"
        helpers:WindowThemes.IsThemed="True">

    <!--MDSHO's own title bar and rounded frame, like the Error window-->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

        <!--Every outer margin of the body and of the bottom bar equals the button height (set in code), like Run command-->
        <StackPanel x:Name="BodyContent" Grid.Row="1" Margin="26">
            <TextBlock
                x:Name="TextHeading"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Theme.TextStrong}"
                TextWrapping="Wrap"
                Text="Enjoying MDSHO?"/>
            <TextBlock
                x:Name="TextMessage"
                Margin="0,6,0,0"
                Foreground="{DynamicResource Theme.TextSecondary}"
                TextWrapping="Wrap"
                Text="A rating in the Microsoft Store helps other people find it. It only takes a minute."/>
        </StackPanel>

        <!--Footer: Later and Rate MDSHO on the right-->
        <Border x:Name="Footer" Grid.Row="2" Background="{DynamicResource Theme.BarBackground}">
            <Grid x:Name="FooterContent" Margin="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ButtonLater" Grid.Column="1" Style="{StaticResource StyleDarkButton}" Content="Later" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="ButtonRate" Grid.Column="2" Style="{StaticResource StyleDarkButton}" Content="Rate MDSHO" IsDefault="True"/>
            </Grid>
        </Border>
    </Grid>

</Window>
