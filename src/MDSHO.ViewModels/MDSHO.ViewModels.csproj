<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain .NET, no WPF types: the views turn plain values into WPF ones with converters in MDSHO.App
         (ArchitectureTests checks this). -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MDSHO.Common\MDSHO.Common.csproj" />
    <ProjectReference Include="..\MDSHO.Core\MDSHO.Core.csproj" />
    <ProjectReference Include="..\MDSHO.Data\MDSHO.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM source generators: ObservableObject, [ObservableProperty], [RelayCommand]. Plain .NET, no WPF. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
